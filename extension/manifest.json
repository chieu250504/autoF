{
  "manifest_version": 3,
  "name": "FB Group Keyword Radar",
  "version": "1.0.0",
  "description": "Tự động theo dõi bài đăng mới theo từ khóa trong nhóm Facebook với cơ chế mô phỏng tự nhiên an toàn tuyệt đối.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://api.telegram.org/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Keyword Radar Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/groups/*",
        "*://facebook.com/groups/*"
      ],
      "js": [
        "supabase.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

